# Rendered at container start from /etc/nginx/templates/default.conf.template
# by the nginx:alpine entrypoint. API_UPSTREAM defaults to the compose
# service name; override for Fly / standalone deployments.

server {
    listen       8080 default_server;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # Gzip on for text assets — helps the JS bundle + CSS.
    gzip             on;
    gzip_comp_level  5;
    gzip_types       text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length  512;

    # Long cache for hashed static assets, no-cache for index.html so
    # new builds are seen immediately.
    location ~ \.(js|css|svg|woff2|png|jpg|gif|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Proxy /api/* to the API service. The API's own /api prefix is
    # stripped so the API continues to see /attribution/events etc.
    location /api/ {
        # Phoenixtekk fork: resolve the upstream at REQUEST time, not at worker
        # start. nginx resolves a literal proxy_pass host once and caches the
        # address for the life of the worker, so recreating the api container
        # (every `docker compose up -d` that rebuilds it) gives it a new IP
        # while nginx keeps dialling the dead one — the whole public /api path
        # 502s, taking the SPA and the Stripe webhook with it, until someone
        # restarts this container. Observed in production 2026-10-27: webhooks
        # for a completed Checkout were lost this way.
        #
        # 127.0.0.11 is Docker's embedded DNS. Putting the host in a variable
        # is what forces nginx to re-resolve per request; the explicit
        # $uri$is_args$args is required because a proxy_pass with a variable
        # does not inherit the rewritten URI on its own.
        # See docs/FORK-PATCHES.md #9.
        #
        # ORDER MATTERS: `set` is a rewrite-module directive, and
        # `rewrite ... break` halts that module for the rest of the location.
        # With the set after the rewrite nginx logs "using uninitialized
        # api_upstream variable" and 500s. Set first, rewrite second.
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $api_upstream ${API_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$api_upstream$uri$is_args$args;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # SPA fallback — every non-asset, non-/api URL serves index.html so
    # react-router owns client-side routing.
    location / {
        try_files $uri /index.html;
    }
}
